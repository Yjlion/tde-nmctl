#: src/app/kcm_nmctl.cpp:80
#, kde-format
msgid ""
"<h1>Network Connections</h1><p>Here you can add, edit and delete the network "
"connections of NetworkManager: wired, Wi-Fi, VPN, WireGuard, mobile "
"broadband, DSL, bonds, bridges and VLANs.</p><p>The <b>Devices</b> tab shows "
"the network devices with their addresses and the Wi-Fi networks in range.</"
"p><p>The <b>Settings</b> tab turns networking, Wi-Fi and mobile broadband on "
"and off, sets the host name and chooses where passwords are stored. Press "
"<b>Apply</b> to save it.</p><p>Changing connections for all users may ask "
"for the administrator password through polkit.</p>"
msgstr ""

